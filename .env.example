# Porta em que o servidor Express vai escutar
PORT=3000

# URL base da sua instância da Evolution API (sem barra no final)
# Ex.: http://localhost:8080  ou  https://sua-evolution.dominio.com
EVOLUTION_API_URL=http://localhost:8080

# API Key global ou da instância, gerada/configurada na Evolution API
EVOLUTION_API_KEY=sua_api_key_aqui

# Nome exato da instância criada no Manager da Evolution API
INSTANCE_NAME=ambulatorio-hu

# Usado em produção para só receber mensagens de um número escolhido
# Ex.: ALLOWED_NUMBER=556799991234
ALLOWED_NUMBER=
